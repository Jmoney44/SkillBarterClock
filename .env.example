# Copy to .env.local and fill in. Never commit real values.

# App URL used in auth and email links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Notification emails (optional; without these, emails stay queued and nothing is sent).
# Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Skill Barter Clock <notifications@your-domain.com>"
# Shared secret for the scheduled /api/cron/notifications call.
CRON_SECRET=a-long-random-string
